ent);color:#fff;border-color:var(--accent)}\n\n/* 使用说明 步骤 */\n.steps{max-width:680px;counter-reset:step}\n.step{border:2px solid var(--ink);margin-bottom:-2px;padding:20px 24px;display:flex;gap:20px;align-items:flex-start}\n.step .s-num{font-size:32px;font-weight:900;color:var(--accent);line-height:1;flex:0 0 auto}\n.step h3{margin:0 0 6px;font-size:17px}\n.step p{margin:0;font-size:14px;color:var(--muted)}\n\n/* FAQ 编号列表 */\n.faq{max-width:760px;counter-reset:faq}\n.faq-item{border:2px solid var(--ink);margin-bottom:-2px;padding:20px 24px;display:grid;grid-template-columns:40px 1fr;gap:16px}\n.faq-item::before{counter-increment:faq;content:counter(faq,decimal-leading-zero);font-size:18px;font-weight:800;color:var(--accent)}\n.faq-item h3{margin:0 0 6px;font-size:16px;font-weight:700}\n.faq-item p{margin:0;font-size:14px;color:var(--muted)}\n\n/* 客户端说明 */\n.clients .card{background:#EFE3D2}\n\nfooter.foot{padding:32px 56px;font-size:13px;color:var(--muted)}\nfooter.foot p{margin:0 0 4px}\n\n@media (max-width:760px){\n  .layout{flex-direction:column}\n  .nav{position:relative;height:auto;flex:1 1 auto;border-right:none;border-bottom:2px solid var(--ink);padding:20px 0}\n  .nav .logo{padding:0 20px 16px}\n  .nav ul{display:flex;flex-wrap:wrap}\n  .nav a{padding:8px 14px}\n  .nav .nav-foot{display:none}\n  .section{padding:36px 20px}\n  .hero{padding:36px 20px 48px}\n  .plan{grid-template-columns:1fr;gap:16px}\n  .plan .p-cta{text-align:left}\n  .faq-item{grid-template-columns:30px 1fr;gap:10px}\n}\n</style><div class=\"layout\">\n<aside class=\"nav\">\n  <div class=\"logo\">极速<span>亚洲</span><br>SpeedAsia</div>\n  <ul>\n    <li><a href=\"#story\">品牌故事</a></li>\n    <li><a href=\"#features\">服务特色</a></li>\n    <li><a href=\"#plans\">套餐方案</a></li>\n    <li><a href=\"#how\">使用指南</a></li>\n    <li><a href=\"#clients\">客户端</a></li>\n    <li><a href=\"#faq\">常见问题</a></li>\n  </ul>\n  <div class=\"nav-foot\">为日常网络体验而生。</div>\n</aside>\n\n<main class=\"main\">\n\n<section class=\"hero\" id=\"top\">\n  <h1>极速亚洲(SpeedAsia) · 极速亚洲<span class=\"red\">.</span><br>陪你走过每一段<span class=\"red\">顺畅</span></h1>\n  <p class=\"tagline\">嘿，朋友。如果你也觉得网络该是顺手、不费神的事，那我们大概聊得来。下面是我们这几年走过的几步路。</p>\n  <div class=\"timeline\">\n    <div class=\"t-item\">\n      <div class=\"t-time\">第一步</div>\n      <div class=\"t-title\">从一小群人的折腾开始</div>\n      <div class=\"t-desc\">几个朋友受够了断流和卡顿，搭了第一批自用线路，慢慢被身边人问起。</div>\n    </div>\n    <div class=\"t-item\">\n      <div class=\"t-time\">第二步</div>\n      <div class=\"t-title\">把线路做成正经服务</div>\n      <div class=\"t-desc\">节点陆续铺开，开始有像样的工单和支持流程，不再是“人肉运维”。</div>\n    </div>\n    <div class=\"t-item\">\n      <div class=\"t-time\">第三步</div>\n      <div class=\"t-title\">流媒体与游戏场景分开优化</div>\n      <div class=\"t-desc\">看剧、打游戏、开会各要各的顺，我们按场景把线路做了区分。</div>\n    </div>\n    <div class=\"t-item now\">\n      <div class=\"t-time\">今天</div>\n      <div class=\"t-title\">给个人和小团队都留了位置</div>\n      <div class=\"t-desc\">无论是自己用，还是带上整个团队，这里都有对应的方案。</div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"story\">\n  <h2><span class=\"num\">01</span>聊聊我们是谁</h2>\n  <p class=\"lede\">极速亚洲 SpeedAsia 是一群在网络一线摸爬滚打好几年的普通人。我们不是什么神秘大厂，只是一群想让上网这件事少点烦心的工程师和爱好者。</p>\n  <p>我们相信，好的网络服务不该让你天天惦记它。它该像水管一样，开着就有，关了就静。所以我们把心思放在两件事上：线路要稳，客服要真。没那么多花哨的话，就是把你交代的网络问题认认真真处理好。</p>\n  <p>如果你第一次接触这类服务，别紧张，下面会把方案和用法一点点说清楚。有不清楚的地方，工单里见，我们都会回。</p>\n</section>\n\n<section class=\"section\" id=\"features\">\n  <h2><span class=\"num\">02</span>我们做了哪些事</h2>\n  <p class=\"lede\">不堆参数，只讲我们每天在做的几件事。</p>\n  <div class=\"cards\">\n    <div class=\"card\">\n      <div class=\"k\">线路</div>\n      <h3>按场景分线路</h3>\n      <p>看剧归看剧，打游戏归打游戏。不同用途走不同优化路径，互不打架。</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"k\">流媒体</div>\n      <h3>主流平台覆盖</h3>\n      <p>常见流媒体平台基本都有对应线路，不用自己折腾解锁脚本。</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"k\">设备</div>\n      <h3>多端同时在线</h3>\n      <p>手机、电脑、平板可以一起挂着，不用来回挤那一个名额。</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"k\">支持</div>\n      <h3>真人工单回复</h3>\n      <p>不是机器人复读。你提的问题有人看、有人答、有人跟进到解决。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"plans\">\n  <h2><span class=\"num\">03</span>挑一个顺手的方案</h2>\n  <p class=\"lede\">三档方案，按你需要选就好。用不完可以随时换档，不用咬牙硬撑。</p>\n  <div class=\"plans\">\n    <article class=\"plan\">\n      <div>\n        <div class=\"p-name\">基础版</div>\n        <div class=\"p-price\">¥15/月<span class=\"p-annual\">按年付 ¥150/年</span></div>\n      </div>\n      <ul>\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n      <div class=\"p-cta\"><a href=\"#\">选择基础版</a></div>\n    </article>\n    <article class=\"plan featured\">\n      <div>\n        <div class=\"p-name\">旗舰版</div>\n        <div class=\"p-price\">¥35/月<span class=\"p-annual\">按年付 ¥350/年</span></div>\n      </div>\n      <ul>\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n      <div class=\"p-cta\"><a href=\"#\">选择旗舰版</a></div>\n    </article>\n    <article class=\"plan\">\n      <div>\n        <div class=\"p-name\">团队版</div>\n        <div class=\"p-price\">¥85/月<span class=\"p-annual\">按年付 ¥850/年</span></div>\n      </div>\n      <ul>\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n      <div class=\"p-cta\"><a href=\"#\">联系团队版</a></div>\n    </article>\n  </div>\n</section>\n\n<section class=\"section\" id=\"how\">\n  <h2><span class=\"num\">04</span>怎么开始用</h2>\n  <p class=\"lede\">不用懂技术，四步就能跑起来。</p>\n  <div class=\"steps\">\n    <div class=\"step\">\n      <div class=\"s-num\">1</div>\n      <div>\n        <h3>选个适合你的套餐</h3>\n        <p>个人用基础版或旗舰版就够了，带团队的话直接看团队版。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"s-num\">2</div>\n      <div>\n        <h3>注册账号并完成开通</h3>\n        <p>填个邮箱设个密码，按提示走完支付，几分钟就能拿到账号信息。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"s-num\">3</div>\n      <div>\n        <h3>下载对应平台的客户端</h3>\n        <p>Windows、macOS、Android、iOS 都有对应客户端，按设备装一个就行。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"s-num\">4</div>\n      <div>\n        <h3>导入订阅，选节点连上</h3>\n        <p>在客户端里粘贴订阅链接，节点列表刷新出来后挑一个顺手的，点连接即可。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section clients\" id=\"clients\">\n  <h2><span class=\"num\">05</span>客户端怎么装</h2>\n  <p class=\"lede\">各平台客户端情况说明如下。具体下载地址以开通后账户后台显示为准。</p>\n  <div class=\"cards\">\n    <div class=\"card\">\n      <div class=\"k\">Windows</div>\n      <h3>官方 Windows 客户端</h3>\n      <p>支持 Windows 10 及以上系统，提供订阅导入与节点切换功能。</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"k\">macOS</div>\n      <h3>官方 macOS 客户端</h3>\n      <p>适配 Intel 与 Apple Silicon，支持系统级代理与分流规则。</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"k\">Android</div>\n      <h3>Android 客户端</h3>\n      <p>支持 Android 8 及以上版本，可在后台保持连接，按应用分流。</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"k\">iOS</div>\n      <h3>iOS / iPadOS</h3>\n      <p>通过 App Store 获取对应客户端，支持按需连接与分流规则导入。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"faq\">\n  <h2><span class=\"num\">06</span>你可能想问的</h2>\n  <p class=\"lede\">把大家最常问的几个问题整理在这里，先看看能不能解答你的疑惑。</p>\n  <div class=\"faq\">\n    <article class=\"faq-item\">\n      <div>\n        <h3>新人第一次用，会不会很难上手？</h3>\n        <p>放心，开通后账户后台有图文引导，按步骤复制订阅、粘贴到客户端、选节点就行。实在卡住，工单里说一声，我们会手把手带你跑通。</p>\n      </div>\n    </article>\n    <article class=\"faq-item\">\n      <div>\n        <h3>流量用完了怎么办？</h3>\n        <p>流量用完后当月会降速或暂停，具体看你选的套餐规则。可以等下月刷新，也可以临时升级到更高档位补流量，不用重新注册账号。</p>\n      </div>\n    </article>\n    <article class=\"faq-item\">\n      <div>\n        <h3>可以同时多台设备用吗？</h3>\n        <p>可以的。基础版支持 3 台、旗舰版 5 台、团队版 20 台同时在线。家里的电脑手机平板可以一起挂着，不用来回挤名额。</p>\n      </div>\n    </article>\n    <article class=\"faq-item\">\n      <div>\n        <h3>套餐能中途换吗？</h3>\n        <p>能。你可以随时在账户后台升级到更高档位，按剩余时长补差价即可。降级则在下个计费周期生效，当月不影响使用。</p>\n      </div>\n    </article>\n    <article class=\"faq-item\">\n      <div>\n        <h3>不想用了能退吗？</h3>\n        <p>我们目前没有承诺无理由退款政策。如果是因为线路故障导致无法使用，可以走工单说明情况，我们会根据实际使用状况协商处理。</p>\n      </div>\n    </article>\n    <article class=\"faq-item\">\n      <div>\n        <h3>游戏加速效果怎么样？</h3>\n        <p>旗舰版及以上提供 IPLC 专线游戏加速优化，针对主流海外游戏做了路由调整。具体表现会因你所在地区和目标服务器而异，建议先月付试试手感。</p>\n      </div>\n    </article>\n  </div>\n</section>\n\n<footer class=\"foot\">\n  <p>极速亚洲 SpeedAsia</p>\n  <p>本页面内容仅供参考，具体服务条款以开通后账户后台展示为准。</p>\n</footer>\n\n</main>\n</div>",
